# Copy this file to .env and fill in what you have. Everything is optional.

# Free key from https://console.groq.com/keys  -> enables voice (Whisper) + LLM understanding
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Leave empty for auto-detect (best for Tanglish). Use "ta" for pure Tamil, "en" for English.
STT_LANGUAGE=

# Razorpay TEST keys (Dashboard -> switch to Test Mode -> Settings -> API Keys). Starts with rzp_test_
# Leave empty to use the built-in demo gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=4000
